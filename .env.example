APP_NAME=SafeDaet API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
UVICORN_WORKERS=2
JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MONGODB_URL=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=safedaet
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
STRIPE_API_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
RESEND_API_KEY=re_your_resend_api_key
RESEND_API_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Safediet
EMAIL_REPLY_TO=support@example.com
WEB_APP_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_BASE_URL=https://api.cloudinary.com/v1_1
CLOUDINARY_UPLOAD_FOLDER_ROOT=safedaet
CLOUDINARY_TIMEOUT_SECONDS=20
